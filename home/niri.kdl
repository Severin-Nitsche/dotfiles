environment {
  GDK_BACKEND "wayland,x11"
  QT_QPA_PLATFORM "wayland;xcb"
  SDL_VIDEODRIVER "wayland"
  CLUTTER_BACKEND "wayland"
  NIXOS_OZONE_WL "1"
}

spawn-at-startup "quickshell"

window-rule {
  match app-id="org.gnome.Calculator"
  open-floating true
  open-focused true
  baba-is-float true
  max-height 50
}

binds {
  Mod+1 {
    maximize-column
  }

  Mod+2 {
    fullscreen-window
  }

  Mod+3 {
    toggle-window-floating
  }

  Mod+L {
    focus-column-right
  }

  Mod+Shift+L {
    focus-monitor-right
  }

  Mod+Shift+H {
    focus-monitor-left
  }

  Mod+Mod5+L {
    move-column-to-monitor-right
  }

  Mod+Mod5+H {
    move-column-to-monitor-left
  }

  Mod+H {
    focus-column-left
  }

  Mod+J {
    focus-workspace-down
  }

  Mod+K {
    focus-workspace-up
  }

  Mod+Q {
    close-window
  }

  Mod+Space hotkey-overlay-title="App Launcher" {
    spawn "rofi" "-show" "drun" "-run-command" "runapp {cmd}"
  }

  Mod+Tab hotkey-overlay-title="App Übersicht" {
    spawn "rofi" "-show"
  }

  Mod+Return hotkey-overlay-title="Terminal" {
    spawn "runapp" "alacritty"
  }

  XF86Calculator {
    spawn "runapp" "gnome-calculator"
  }

  XF86KbdBrightnessDown {
    spawn "brightnessctl" "set" "-c" "leds" "-d" ":white:kbd_backlight" "-e" "20%-"
  }

  XF86KbdBrightnessUp {
    spawn "brightnessctl" "set" "-c" "leds" "-d" ":white:kbd_backlight" "-e" "+20%"
  }

  XF86MonBrightnessDown {
    spawn "brightnessctl" "set" "-c" "backlight" "-d" "intel_backlight" "-e" "4%-"
  }

  XF86MonBrightnessUp {
    spawn "brightnessctl" "set" "-c" "backlight" "-d" "intel_backlight" "-e" "+4%"
  }

  Mod+Mod5+BackSpace hotkey-overlay-title="Abmelden" {
    quit
  }

  Mod+Shift+4 {
    screenshot
  }

  Print {
    screenshot-screen
  }
}

output "eDP-1" {
  focus-at-startup
  position x=0 y=0
}

output "DP-5" {
  position x=1463 y=0
}

cursor {
  hide-when-typing
  hide-after-inactive-ms 1500
}

hotkey-overlay {
  skip-at-startup
}

input {
  disable-power-key-handling

  keyboard {
    xkb {
      layout "de,math"
      variant "mac,lvl5"
      options "power:caps,power:alt3"
      rules "evdev"
    }
  }

  keyboard "ERGO K860 Keyboard" {
    xkb {
      layout "de,math"
      variant "mac,lvl5"
      options "power:caps,power:alt3,mac:k860"
      rules "evdev"
    }
  }

  touchpad {
    tap
    natural-scroll
    scroll-factor 0.8
    scroll-method "two-finger"
    click-method "clickfinger"
    dwt
  }
}
